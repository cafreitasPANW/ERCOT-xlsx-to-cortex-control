# Copy to .env and fill in. `.env` is gitignored; never commit real keys.
# Values can be quoted or unquoted. Variables already set in the shell take precedence.

# Tenant API host: Cortex > Settings > Configurations > API Keys > "Copy URL" (host part only)
CORTEX_FQDN=api-<tenant>.xdr.<region>.paloaltonetworks.com

# API key ID (the "ID" column in the API Keys table; sent as x-xdr-auth-id)
CORTEX_API_KEY_ID=1234

# Standard API key (sent as the Authorization header)
CORTEX_API_KEY=<paste key here>

# Optional: use a different env file: CORTEX_ENV_FILE=lab.env python xlsx_to_cortex_controls.py ...
